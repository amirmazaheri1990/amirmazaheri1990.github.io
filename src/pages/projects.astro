---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base title="Projects" description="Research and engineering projects by Amir Mazaheri.">
  <h1>Projects</h1>
  <p class="tagline">Research papers, patents, and engineering work — each with its own page.</p>

  <div class="stack">
    {projects.map((project) => {
      const venues = project.data.publications.map(
        (p) => `${p.venue} ${p.year}`
      );
      const hasPatent = project.data.patents.length > 0;
      const videoUrl =
        project.data.links.video ??
        project.data.publications.find((p) => p.links.video)?.links.video;
      return (
        <article class="card project-card">
          <div class="row-between">
            <h3>
              <a class="stretched-link" href={`/projects/${project.slug}`}>{project.data.title}</a>
            </h3>
            {project.data.period && <span class="date">{project.data.period}</span>}
          </div>
          <p class="muted">{project.data.summary}</p>
          <div class="row">
            {venues.map((v) => <span class="badge venue">{v}</span>)}
            {hasPatent && <span class="badge patent">Patent</span>}
            {videoUrl && (
              <a class="badge video" href={videoUrl} rel="noopener" target="_blank">▶ Watch on YouTube</a>
            )}
            {project.data.tags.map((t) => <span class="tag">{t}</span>)}
          </div>
        </article>
      );
    })}
  </div>
</Base>

<style>
.project-card {
  position: relative;
}
.project-card h3 {
  margin: 0 0 0.35rem;
}
.project-card h3 a {
  color: var(--text);
  border-bottom: none;
}
.project-card h3 a:hover {
  color: var(--accent);
}
/* Stretched-link: make the whole card clickable via the title anchor,
   while other anchors (e.g. the YouTube badge) sit above and take
   their own clicks. */
.stretched-link::after {
  content: '';
  position: absolute;
  inset: 0;
  z-index: 0;
}
.badge {
  display: inline-block;
  padding: 0.1rem 0.5rem;
  font-size: 0.8125rem;
  font-weight: 600;
  border-radius: 999px;
  border: 1px solid transparent;
}
.badge.venue {
  background: color-mix(in srgb, var(--accent) 12%, transparent);
  color: var(--accent);
  border-color: color-mix(in srgb, var(--accent) 25%, transparent);
}
.badge.patent {
  background: color-mix(in srgb, #f59e0b 12%, transparent);
  color: #b45309;
  border-color: color-mix(in srgb, #f59e0b 30%, transparent);
}
a.badge.video {
  position: relative;
  z-index: 1;
  background: color-mix(in srgb, #ff0000 10%, transparent);
  color: #cc0000;
  border-color: color-mix(in srgb, #ff0000 30%, transparent);
  border-bottom: none;
  text-decoration: none;
}
a.badge.video:hover {
  background: color-mix(in srgb, #ff0000 20%, transparent);
  color: #a00000;
}
@media (prefers-color-scheme: dark) {
  .badge.patent { color: #fbbf24; }
  a.badge.video { color: #ff8080; }
  a.badge.video:hover { color: #ffb3b3; }
}
</style>
